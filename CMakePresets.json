{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug, GCC 13",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release, GCC 13 (numbers come from this or cuda)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang",
      "displayName": "Debug, Clang 18",
      "inherits": "clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WAFEREDGE_SANITIZE": "address,undefined",
        "WAFEREDGE_BENCH": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WAFEREDGE_SANITIZE": "thread",
        "WAFEREDGE_BENCH": "OFF"
      }
    },
    {
      "name": "cuda",
      "displayName": "Release with the CUDA backend (sm_86)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WAFEREDGE_CUDA": "ON",
        "CMAKE_CUDA_HOST_COMPILER": "g++-11",
        "CMAKE_CUDA_ARCHITECTURES": "86"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + ASan/UBSan, Clang 18",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WAFEREDGE_SANITIZE": "fuzzer",
        "WAFEREDGE_BENCH": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "cuda", "configurePreset": "cuda" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "clang", "inherits": "base", "configurePreset": "clang" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    { "name": "cuda", "inherits": "base", "configurePreset": "cuda" },
    {
      "name": "cuda-cpu",
      "displayName": "CUDA build, CPU tests only (no GPU, as in CI)",
      "inherits": "base",
      "configurePreset": "cuda",
      "filter": { "exclude": { "label": "gpu" } }
    },
    { "name": "fuzz", "inherits": "base", "configurePreset": "fuzz" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "clang",
      "steps": [
        { "type": "configure", "name": "clang" },
        { "type": "build", "name": "clang" },
        { "type": "test", "name": "clang" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "cuda",
      "steps": [
        { "type": "configure", "name": "cuda" },
        { "type": "build", "name": "cuda" },
        { "type": "test", "name": "cuda" }
      ]
    }
  ]
}
